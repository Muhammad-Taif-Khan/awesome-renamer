{
  "name": "awesome-renamer",
  "version": "2.0.0",
  "description": "Rule-based file and directory renaming with single and batch APIs, validation, and collision handling.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "tsdown src/index.ts --format cjs --platform node --out-dir .test-dist && node --test test/api.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-Taif-Khan/awesome-renamer.git"
  },
  "keywords": [
    "folder-renamer",
    "file-renamer",
    "node-renamer",
    "renamer"
  ],
  "author": "Muhammad Taif Khan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Muhammad-Taif-Khan/awesome-renamer.git/issues"
  },
  "homepage": "https://github.com/Muhammad-Taif-Khan/awesome-renamer.git#readme",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.1.1",
    "publint": "^0.3.23",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}